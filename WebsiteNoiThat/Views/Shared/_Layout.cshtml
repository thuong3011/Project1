    <script>
        function toggleChat() {
            var box = document.getElementById('chat-container');
            box.style.display = (box.style.display === 'flex') ? 'none' : 'flex';
        }

        function checkEnter(e) {
            if (e.key === 'Enter') sendMessage();
        }

        function sendMessage() {
            var input = document.getElementById('chat-input');
            var message = input.value.trim();

            var userIdEl = document.getElementById('current-user-id');
            var userId = userIdEl ? userIdEl.value : "";



            if (!message) return;

            appendMessage(message, 'user');
            input.value = '';

            var loadingId = appendMessage('...', 'bot');

            fetch('https://api-noithat.onrender.com/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message, user_id: userId })
            })
                .then(res => res.json())
                .then(data => {
                    var loadMsg = document.getElementById(loadingId);
                    if (loadMsg) loadMsg.remove();
                    appendMessage(data.reply, 'bot');
                })
                .catch(err => {
                    console.error(err);
                    var loadMsg = document.getElementById(loadingId);
                    if (loadMsg) loadMsg.innerText = "Lỗi kết nối.";
                });
        }

        function appendMessage(text, type) {
            var div = document.createElement('div');
            div.className = 'msg ' + type;
            div.innerText = text;
            div.id = 'msg-' + Math.random().toString(36).substr(2, 9);
            var box = document.getElementById('chat-box');
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
            return div.id;
        }
    </script>


