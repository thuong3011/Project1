    <style>
        /* ===== BUTTON CHAT ===== */
        #chat-toggler {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 60px;
            height: 60px;
            background: #8B4513;
            color: white;
            border-radius: 50%;
            border: 2px solid #fff;
            font-size: 30px;
            cursor: pointer;
            z-index: 2147483647;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.3s;
        }
        /* Hiệu ứng rung nhẹ */

        @@keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.06);
            }

            100% {
                transform: scale(1);
            }
        }

        /* Áp dụng cho icon Messenger và Zalo */
        #chat-icons a {
            animation: pulse 1.5s infinite ease-in-out;
        }

            /* Khi hover dừng hiệu ứng và phóng to */
            #chat-icons a:hover {
                animation: none;
                transform: scale(1.12);
            }


        /* ===== CHAT BOX ===== */
        #chat-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 320px;
            height: 450px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            display: none;
            flex-direction: column;
            z-index: 2147483647;
            overflow: hidden;
            font-family: Arial, sans-serif;
        }

        #chat-header {
            background: #8B4513;
            color: white;
            padding: 15px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #chat-box {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            background: #f5f5f5;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .msg {
            padding: 8px 12px;
            border-radius: 10px;
            max-width: 80%;
            font-size: 14px;
            line-height: 1.4;
        }

            .msg.bot {
                background: #e9ecef;
                color: #333;
                align-self: flex-start;
            }

            .msg.user {
                background: #8B4513;
                color: white;
                align-self: flex-end;
            }

        #chat-input-area {
            display: flex;
            border-top: 1px solid #ddd;
            padding: 10px;
            background: #fff;
        }

        #chat-input {
            flex: 1;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 20px;
            outline: none;
            margin-right: 10px;
        }

        #send-btn {
            background: #8B4513;
            color: white;
            border: none;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            cursor: pointer;
        }

        /* ===== ICON MESSENGER + ZALO ===== */
        #chat-icons {
            position: fixed;
            bottom: 100px; /* nằm trên nút chat */
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 2147483647;
        }

            #chat-icons a {
                width: 60px;
                height: 60px;
                background: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #ddd;
                box-shadow: 0 3px 8px rgba(0,0,0,0.2);
                transition: transform 0.2s;
            }

                #chat-icons a:hover {
                    transform: scale(1.1);
                }

            #chat-icons img {
                width: 45px;
                height: 45px;
            }
    </style>
</head>

