@model PagedList.PagedList<WebsiteNoiThat.Models.HistoryCart>
@using PagedList.Mvc;
@using PagedList;
  @{  ViewBag.Title = "Lỗi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section jsFooter{
    <script src="~/Scripts/cartcontroller.js"></script>

}
<div class="alert alert-danger">
    Không thể hủy đơn hàng. Quý khách vui lòng liên hệ đến số điện thoại 19001009 để hủy trực tiếp.
</div>
<div class="content">
    <div class="section group">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @if (Model.Count > 0)
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <td>Mã SP</td>
                        <td>Tên SP</td>
                        <td>Ảnh SP</td>
                        <td>Số lượng</td>
                        <td>Đơn giá</td>
                        <th>Khuyến mãi</th>
                        <td>Thành tiền</td>
                        <td>Trạng thái</td>
                        <td></td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OrderId</td>
                            <td>@item.ProductId</td>
                            <td>@item.Name</td>
                            <td><img src="@Url.Content("~/image/" + item.Photo)" width="100" /></td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.GetValueOrDefault(0).ToString("N0")</td>
                            @if (item.Discount > 0)
                            {
                                <td style="color:crimson">@item.Discount %</td>
                            }
                            else

                            {
                                <td>Không</td>
                            }
                            <td>@string.Format("{0:#,###.##}", ((item.Price - (item.Price * item.Discount * 0.01)) * item.Quantity))</td>
                            <td style="color:darkslategray">@item.NameStatus</td>
                            <td><a href="/Cart/DeleteItem?id=@item.OrderDetaiId" data-id="@item.ProductId">Hủy đơn hàng</a></td>
                        </tr>
                    }
                </tbody>
            </table>

        }
        <div style="clear:both;"></div>
        Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber)/@Model.PageCount
        <div class="Menutrang">
            @Html.PagedListPager(Model, page => Url.Action("HistoryCart", new { page = page }))
        </div>
        <style>
            .Menutrang li {
                display: inline;
            }
        </style>
        else
        {
        <hr />
        <span class="alert alert-danger">Chưa có sản phẩm nào trong giỏ hàng</span>
        }
    </div>
</div>

