@using PagedList
@using PagedList.Mvc
@model IPagedList<WebsiteNoiThat.Models.HistoryCart>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light text-center">
        <tr>
            <th>Mã đơn</th>
            <th>Sản phẩm</th>
            <th>Hình ảnh</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>KM</th>
            <th>Thành tiền</th>
            <th>Trạng thái</th>
            <th>Hủy</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var group in Model.GroupBy(x => x.OrderId))
            {
                bool first = true;
                int rowCount = group.Count();

                foreach (var item in group)
                {
                    <tr class="order-row order-@item.OrderId">
                        @if (first)
                        {
                            <td rowspan="@rowCount" class="text-center fw-bold">
                                #@group.Key
                            </td>
                        }

                        <td>@item.Name</td>

                        <td class="text-center">
                            <img src="~/image/@item.Photo" width="70" class="img-thumbnail" />
                        </td>

                        <td class="text-center">@item.Quantity</td>

                        <td class="text-end">
                            @item.Price.GetValueOrDefault(0).ToString("N0")₫
                        </td>

                        <td class="text-center">
                            @(item.Discount > 0 ? item.Discount + "%" : "—")
                        </td>

                        <td class="text-end">
                            @string.Format("{0:N0}",
                                (item.Price - item.Price * item.Discount / 100) * item.Quantity)₫
                        </td>

                        @if (first)
                        {
                            <td rowspan="@rowCount" class="text-center status-cell">
                                <span class="badge bg-info status">
                                    @item.NameStatus
                                </span>
                            </td>

                            <td rowspan="@rowCount" class="text-center action-cell">
                                @if (item.StatusId == 1|| item.StatusId == 2)
                                {
                                    <button class="btn btn-sm btn-outline-danger btn-cancel"
                                            data-id="@item.OrderId">
                                        Hủy
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        }
                    </tr>

                    first = false;
                }
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center text-muted py-4">
                    Không có đơn hàng
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model != null && Model.PageCount > 1)
{
    <div class="d-flex justify-content-center mt-3">
        @Html.PagedListPager(
            Model,
            page => Url.Action("HistoryCartPartial", new { page }),
            new PagedListRenderOptions
            {
                UlElementClasses = new[] { "pagination", "ajax-pagination" }
            }
        )
    </div>
}
