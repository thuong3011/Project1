@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .status-bar {
        display: flex;
        gap: 30px;
        border-bottom: 2px solid #eee;
        padding: 10px 0;
        margin-bottom: 15px;
    }

        .status-bar li {
            cursor: pointer;
            font-weight: 600;
            color: #555;
            position: relative;
        }

            .status-bar li.active {
                color: #ee4d2d;
            }

                .status-bar li.active::after {
                    content: "";
                    position: absolute;
                    bottom: -10px;
                    left: 0;
                    width: 100%;
                    height: 3px;
                    background: #ee4d2d;
                }
</style>

<ul class="status-bar">
    <li class="active" data-status="">Tất cả</li>
    @foreach (var s in ViewBag.StatusMenu)
    {
        <li data-status="@s.StatusId">
            @s.Name <span class="count">(@s.Count)</span>
        </li>
    }
</ul>

<div id="history-table"></div>

@section jsFooter{
    <script>
        $(function () {

            let currentStatus = "";

            loadHistory("");

            // CLICK STATUS
            $(".status-bar").on("click", "li", function () {
                $(".status-bar li").removeClass("active");
                $(this).addClass("active");

                currentStatus = $(this).data("status") || "";
                loadHistory(currentStatus);
            });

            // AJAX PAGINATION
            $(document).on("click", ".ajax-pagination a", function (e) {
                e.preventDefault();
                $("#history-table").load($(this).attr("href") + "&statusId=" + currentStatus);
            });

            // CANCEL ORDER
            $(document).off("click", ".btn-cancel");
            $(document).on("click", ".btn-cancel", function () {

                let btn = $(this);
                if (btn.data("loading")) return;
                btn.data("loading", true);

                if (!confirm("Bạn chắc chắn muốn hủy đơn hàng này?")) {
                    btn.data("loading", false);
                    return;
                }

                let orderId = btn.data("id");

                $.post("/Cart/CancelOrder", { orderId })
                    .done(function (res) {
                        if (res.success) {

                            $(".order-" + orderId + " .status")
                                .removeClass("bg-info")
                                .addClass("bg-danger")
                                .text("Đã hủy");

                            $(".order-" + orderId + " .action-cell")
                                .html('<span class="text-muted">—</span>');

                            updateStatusCounts(res.statusCounts);
                        } else {
                            alert(res.message);
                        }
                    })
                    .always(function () {
                        btn.data("loading", false);
                    });
            });

            function loadHistory(statusId) {
                $("#history-table").load("/Cart/HistoryCartPartial", { statusId });
            }

            function updateStatusCounts(statusCounts) {
                $(".status-bar li .count").text("(0)");
                statusCounts.forEach(x => {
                    $(".status-bar li[data-status='" + x.StatusId + "']")
                        .find(".count").text("(" + x.Count + ")");
                });
            }
        });
    </script>
}
