@using PagedList;
@using PagedList.Mvc;
@model IPagedList<Models.EF.Product>

@{
    ViewBag.Title = ViewBag.CategoryName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

@section Noidungmenu{

    <h3 id="title_spmoi" style="text-align:center;">
        @if (ViewBag.CategoryName != null)
        {
            @ViewBag.CategoryName.ToString().ToUpper()
        }
        else
        {
            <span>SẢN PHẨM</span>
        }
    </h3>

    <div class="ct-boxmain row m0">
        @if (Model != null && Model.Count > 0)
        {
            int i = 0;
            foreach (var sp in Model)
            {
                i++;
                // Kiểm tra xem sản phẩm có đang Sale hay không
                bool isSale = (sp.Discount != 0 && sp.EndDate > DateTime.Now && sp.StartDate < DateTime.Now);

                <div class="col-xs-6 col-sm-4 col-md-3 p5">
                    <div class="boxsp">
                        <div class="imgsp">
                            <a href="@Url.Action("DetailProduct", "Product", new { @Id = sp.ProductId })" data-toggle="tooltip" title="@sp.Name">
                                <img class="imgproduct" style="width:200px;height:160px; object-fit:cover;" src="@Url.Content("~/image/" + sp.Photo)">
                            </a>

                            @if (isSale)
                            {
                                <div class="img-label">
                                    <img style="width:50px;height:50px;" src="~/image/sale-icon.png">
                                </div>
                            }
                        </div>

                        <div class="namesp">
                            <a href="@Url.Action("DetailProduct", "Product", new { @Id = sp.ProductId })">@sp.Name</a>
                        </div>

                        <div class="pricesp">
                            @if (isSale)
                            {
                                <i style="color:red">
                                    @string.Format("{0:#,###.##}", (sp.Price - (sp.Price * sp.Discount * 0.01)))₫
                                </i>
                                <br />
                                <strike style="color:dimgray; font-size:0.9em"> @sp.Price.GetValueOrDefault(0).ToString("N0")₫ </strike>
                            }
                            else
                            {
                                <span>@sp.Price.GetValueOrDefault(0).ToString("N0")₫</span>
                            }
                        </div>

                        @if (isSale)
                        {
                            <p style="font-size:11px; color:#666">
                                Từ @string.Format("{0:dd/MM}", sp.StartDate) - @string.Format("{0:dd/MM}", sp.EndDate)
                            </p>
                        }

                        <div class="button-hd">
                            <a href="/them-gio-hang?ProductId=@sp.ProductId&quantity=1"><i class="fa fa-shopping-cart" aria-hidden="true"></i></a>
                        </div>
                    </div>
                </div>

                // Ngắt dòng sau mỗi 4 sản phẩm (Fix layout)
                if (i % 4 == 0)
                {
                    <div class="clearfix visible-md-block visible-lg-block"></div>
                }
            }
        }
        else
        {
            <div class="alert alert-warning">Chưa có sản phẩm nào trong danh mục này.</div>
        }
    </div>
}

<div class="clearfix"></div>

<div style="text-align:center; margin-top:20px;">
    Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount

    @Html.PagedListPager(Model, page => Url.Action("CategoryShow",
        new { cateId = ViewBag.IdCategory, page = page }), // <--- Đã sửa 'id' thành 'cateId'
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5,
            ClassToApplyToFirstListItemInPager = "first",
            ClassToApplyToLastListItemInPager = "last",
            ContainerDivClasses = new[] { "pagination-container" },
            UlElementClasses = new[] { "pagination" },
            LiElementClasses = new[] { "page-item" }
        })
</div>